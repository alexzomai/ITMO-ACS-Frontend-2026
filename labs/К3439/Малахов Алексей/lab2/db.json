      "difficulty": "Легко",
      "time": 40,
      "servings": 4,
      "userId": 1,
      "description": "Густой осенний суп из запечённой тыквы с карри и кокосовым молоком.",
      "tags": [
        "Тыква",
        "Молоко"
      ],
      "ingredients": [
        {
          "name": "Тыква",
          "amount": "800 г"
        },
